# Copy to deploy/.env (not committed). Generate secrets with: openssl rand -hex 24

# Database passwords (hex: they go into connection URLs unescaped)
POSTGRES_PASSWORD=
WITX_OWNER_PASSWORD=
WITX_APP_PASSWORD=

# Where people open WitX. With https, cookies are Secure; set it when TLS is on.
WITX_PUBLIC_URL=http://localhost
# WITX_HTTP_PORT=80

# Models (decision D10): the worker calls OpenAI
OPENAI_API_KEY=
WITX_DEFAULT_MODEL=gpt-6-luna
# More models (decision D2); the risk check uses the task's model:
# WITX_MODELS=gpt-6-luna=openai,deepseek-v4.1-flash=deepinfra:deepseek-ai/DeepSeek-V4.1-Flash
# DEEPINFRA_API_KEY=
# HTTPS_PROXY=http://proxy.internal:3128
# NO_PROXY=postgres,api,localhost,127.0.0.1

# Sign-in (decision D12). "dev" accepts the fixed tokens below: for trying it out only.
WITX_AUTH=oidc
WITX_OIDC_ISSUER=
WITX_OIDC_CLIENT_ID=
WITX_OIDC_CLIENT_SECRET=
# WITX_AUTH=dev
# WITX_DEV_TOKENS=a-long-random-token=ann

# Monitoring: /metrics on the internal network only (Nginx does not expose it)
# WITX_METRICS_TOKEN=
# WITX_SCREENSHOT_RETENTION_DAYS=30
# WITX_AUDIT_RETENTION_DAYS=90
