# Local development only. Replace model IDs with ones available to your account.
# Copy to .env and load it in your shell (e.g. `set -a; . ./.env; set +a`).

# Database. The application role must NOT own the tables (row-level security).
WITX_DATABASE_URL=postgresql://witx_app_login@localhost/witx
# Owner role, used only by `witx migrate` and `witx admin ...`.
WITX_ADMIN_DATABASE_URL=postgresql://witx_owner@localhost/witx

# Screenshots: file:///absolute/path, or s3://bucket?endpoint=https://...&region=...
WITX_OBJECT_STORE=file:///tmp/witx-objects
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Installed plugins the agent's skills come from (worker only; `witx plugin ...`, D85)
# WITX_PLUGINS_DIR=~/.witx/plugins

# Model (worker only)
OPENAI_API_KEY=
# Only when WITX_MODELS uses deepinfra:
DEEPINFRA_API_KEY=
WITX_DEFAULT_MODEL=gpt-6-luna
# WITX_OPENAI_BASE_URL=https://api.openai.com/v1
# Models tasks may use: name=provider[:provider model ID][@lowest effort],
# comma-separated. A model offers medium and up, or from its @effort up (low, D88).
# Unset: only WITX_DEFAULT_MODEL, at OpenAI. The risk check uses the task's model.
# WITX_MODELS=gpt-6-luna=openai,gpt-6.1-sol=openai@low,deepseek-v4.1-flash=deepinfra:deepseek-ai/DeepSeek-V4.1-Flash,claude-opus-5-5=deepinfra:anthropic/claude-opus-5-5@low
# WITX_CONTEXT_IMAGES=1        # screenshots attached per request; "all" attaches every one
# WITX_SCREENSHOT_RETENTION_DAYS=30   # screenshots of finished tasks
# WITX_AUDIT_RETENTION_DAYS=90        # the summary a deleted task leaves

# Logs: one JSON object per line (or "text"), at this level. /metrics is off without a token.
# WITX_LOG_FORMAT=json
# WITX_LOG_LEVEL=INFO
# WITX_METRICS_TOKEN=
# WITX_REASONING_EFFORT=medium # medium (default), high, xhigh or max; never lower (the risk check's too)

# Where people open the Web app: OIDC redirects, Secure cookies, the allowed Origin
WITX_PUBLIC_URL=http://127.0.0.1:5173

# Sign-in: "dev" (developer tokens) or "oidc". The backend runs the OIDC sign-in as a
# confidential client and gives the browser an HttpOnly session cookie.
WITX_AUTH=dev
WITX_DEV_TOKENS=dev-token-alice=alice
# WITX_OIDC_ISSUER=https://id.example.com/realms/witx
# WITX_OIDC_CLIENT_ID=witx-web
# WITX_OIDC_CLIENT_SECRET=
# Bearer access tokens of programs (not browsers) are checked against these:
# WITX_OIDC_AUDIENCE=witx
# WITX_OIDC_JWKS_URL=https://id.example.com/realms/witx/protocol/openid-connect/certs

# Only needed when the Web app is served from another origin of the same site
# WITX_CORS_ORIGINS=https://app.example.com

WITX_METRICS_TOKEN=
